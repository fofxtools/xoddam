---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" path="/404/" noindex>
  <main>
    <h1>Oh no! That page ran away.</h1>
    <p><a class="button" href="/">Back to the game</a></p>
  </main>
</Base>

<style>
  main {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    padding: 1.5rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 7vw, 3.2rem);
  }
</style>
