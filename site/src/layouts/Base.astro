---
import '@fontsource-variable/fredoka';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  /** Path of this page, for the canonical link (for example "/privacy/"). */
  path?: string;
  noindex?: boolean;
}
const { title, description = SITE.description, path = '/', noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(path, SITE.url).href;
const image = new URL('/og-image.jpg', SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#4aa3f0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      SITE.gaId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`} />
          <script
            is:inline
            set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${SITE.gaId}');`}
          />
        </>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --ink: #173a5c;
    --blue: #3b8be8;
    --blue-light: #63a8f5;
    --card: #eef6ff;
    --sky: #a9d6f5;
  }
  * {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    font-family: 'Fredoka Variable', system-ui, 'Segoe UI', Roboto, sans-serif;
    font-weight: 500;
    color: var(--ink);
    background: var(--sky);
    line-height: 1.5;
  }
  a {
    color: var(--blue);
  }
  .button {
    display: inline-block;
    padding: 0.6em 1.8em;
    font: inherit;
    font-weight: 700;
    font-size: clamp(1.5rem, 5vw, 2.2rem);
    color: #fff;
    text-decoration: none;
    text-shadow: 0 2px 0 var(--ink);
    background: var(--blue);
    border: 5px solid var(--ink);
    border-radius: 999px;
    box-shadow: 0 6px 0 rgba(23, 58, 92, 0.45);
  }
  .button:hover,
  .button:focus-visible {
    background: var(--blue-light);
  }
</style>
