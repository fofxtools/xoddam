# Copy this file to .env (git ignores it) and fill in what you need. None of it is needed to play or build the game.

# tools/openai_edit.py (making pictures)
OPENAI_API_KEY=

# site/scripts/deploy.py (uploading the website to its server over ssh)
XODDAM_HOST=server.example.com
XODDAM_USER=your-ssh-user
XODDAM_DOCROOT=/home/your-ssh-user/public_html
# Optional: path of the ssh private key (default ~/.ssh/id_ed25519)
# XODDAM_KEY=~/.ssh/id_ed25519

# tools/export_android.py (building the Android app)
# Path of the Godot console exe
GODOT_BIN=C:\path\to\Godot_v4.7.2-stable_win64_console.exe
# The release signing key (the project's storage/keys/ folder is git-ignored). BACK IT UP somewhere else as well: if it is
# lost, new versions cannot be installed over an existing install. Godot reads these three names by itself.
GODOT_ANDROID_KEYSTORE_RELEASE_PATH=C:\path\to\xoddam-release.keystore
GODOT_ANDROID_KEYSTORE_RELEASE_USER=xoddam
GODOT_ANDROID_KEYSTORE_RELEASE_PASSWORD=
# Only for the checks at the end of the export (the Java 17 folder and the Android SDK folder)
JAVA_HOME=C:\path\to\jdk-17
ANDROID_SDK_ROOT=C:\path\to\Android\Sdk
